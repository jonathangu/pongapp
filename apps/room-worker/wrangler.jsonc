{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pongapp-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "ratelimits": [{ "name": "CLIENT_DIAGNOSTICS_LIMITER", "namespace_id": "26090701", "simple": { "limit": 60, "period": 60 } }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "VOYAGES",
        "class_name": "VoyageDirector"
      },
      {
        "name": "RESCUE_ROOMS",
        "class_name": "RescueRoom"
      },
      {
        "name": "PUZZLE_ROOMS",
        "class_name": "PuzzleRoom"
      },
      {
        "name": "RICOCHET_ROOMS",
        "class_name": "RicochetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2-voyage-director",
      "new_sqlite_classes": ["VoyageDirector"]
    },
    {
      "tag": "v3-starling-rescue",
      "new_sqlite_classes": ["RescueRoom"]
    },
    {
      "tag": "v4-starling-puzzle",
      "new_sqlite_classes": ["PuzzleRoom"]
    },
    {
      "tag": "v5-ricochet-prototype",
      "new_sqlite_classes": ["RicochetRoom"]
    }
  ],
  "vars": {
    "ENABLE_PAID": "true",
    "MONTHLY_BUDGET_USD": "100",
    "OPENROUTER_LIMIT_CONFIRMED": "shared-user-authorized"
  }
}
