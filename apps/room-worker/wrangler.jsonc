{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pongapp-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "VOYAGES",
        "class_name": "VoyageDirector"
      },
      {
        "name": "RESCUE_ROOMS",
        "class_name": "RescueRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2-voyage-director",
      "new_sqlite_classes": ["VoyageDirector"]
    },
    {
      "tag": "v3-starling-rescue",
      "new_sqlite_classes": ["RescueRoom"]
    }
  ],
  "vars": {
    "ENABLE_PAID": "true",
    "MONTHLY_BUDGET_USD": "100",
    "OPENROUTER_LIMIT_CONFIRMED": "shared-user-authorized"
  }
}
