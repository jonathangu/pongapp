{
  "name": "@pongapp/room-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node dist/server.cjs",
    "start": "node dist/server.cjs",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pongapp/game-core": "workspace:*",
    "@pongapp/protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
